# Configure estos valores en Settings > Secrets de Streamlit. Nunca publique el PAR.
ORACLE_PAR_URL = ""
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-5-mini"

# IA desactivada hasta una verificación administrativa real.
# No basta con tener ChatGPT ni una clave de API.
AI_ENABLED = false
INCLUDED_CREDITS_ONLY_VERIFIED = false
NO_PAID_FALLBACK_VERIFIED = false
CREDITS_VERIFIED_UNTIL = ""
# Reserva conservadora por pregunta completa (interpretación + respuesta), en USD.
AI_TURN_RESERVE_USD = 0.05
# Límite de esta ejecución del servidor, menor que los créditos verificados disponibles.
AI_RUN_BUDGET_USD = 0.0
# Completar únicamente tras comprobar recursos existentes sin servicios pagos nuevos.
HOSTING_AND_ORACLE_QUOTA_VERIFIED = false
